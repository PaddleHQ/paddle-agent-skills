# Paddle API keys for the Paddle MCP servers.
#
# The plugin wires up two MCP servers so the agent can work against both
# Paddle environments — for example, prototyping a catalog in sandbox and
# then porting it to live. Each server reads its own API key from the env.
#
# +----------------+-----------------------------------+---------------------------+
# | MCP server     | URL                               | API key env var           |
# +----------------+-----------------------------------+---------------------------+
# | paddle-live    | https://mcp.paddle.com/mcp        | PADDLE_LIVE_API_KEY       |
# | paddle-sandbox | https://sandbox-mcp.paddle.com/mcp| PADDLE_SANDBOX_API_KEY    |
# +----------------+-----------------------------------+---------------------------+
#
# You only need to set the keys for the environments you actually use. The
# unset one will fail to authenticate at editor startup — that's harmless,
# Claude Code logs it and moves on.
#
# Generate keys at Paddle > Developer tools > Authentication:
#   - Live:    https://vendors.paddle.com/authentication-v2
#   - Sandbox: https://sandbox-vendors.paddle.com/authentication-v2
#
# Sandbox keys are prefixed with `pdl_sdbx_`. Grant the scopes you want the
# agent to have — for full coverage of the skills, enable product.write,
# price.write, customer.read/write, subscription.read/write, transaction.read,
# and notification.write. During development it's fine to grant all scopes.
#
# These variables must be exported in the shell that launches your editor
# (zsh / bash profile, direnv, etc.) — the plugin reads them from the
# process env, not from this file directly.

# Live environment — use with care, this is real customer data.
PADDLE_LIVE_API_KEY=

# Sandbox environment — safe for testing, the default for most development.
PADDLE_SANDBOX_API_KEY=
