{
  "mcpServers": {
    "paddle-docs": {
      "type": "http",
      "url": "https://paddlehq.mcp.kapa.ai",
      "oauth_resource": "https://paddlehq.mcp.kapa.ai/"
    },
    "paddle-live": {
      "type": "http",
      "url": "https://mcp.paddle.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            }
          }
        }
      }
    },
    "paddle-sandbox": {
      "type": "http",
      "url": "https://sandbox-mcp.paddle.com/mcp",
      "bearer_token_env_var": "PADDLE_SANDBOX_API_KEY"
    }
  }
}
